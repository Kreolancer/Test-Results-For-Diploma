Detector: reentrancy-events
Reentrancy in MiniMeToken.approve(address,uint256) ():
	External calls:
	- ! Controller(controller).onApprove(msg.sender,_spender,_amount) ()
	Event emitted after the call(s):
	- Approval(msg.sender,_spender,_amount) ()
Reentrancy in MiniMeToken.createCloneToken(string,uint8,string,uint256,bool) ():
	External calls:
	- cloneToken = tokenFactory.createCloneToken(this,_snapshotBlock,_cloneTokenName,_cloneDecimalUnits,_cloneTokenSymbol,_transfersEnabled) ()
	- cloneToken.changeController(msg.sender) ()
	Event emitted after the call(s):
	- NewCloneToken(address(cloneToken),_snapshotBlock) ()
Reentrancy in MiniMeToken.destroyTokens(address,uint256) ():
	External calls:
	- previousBalanceFrom = balanceOf(_owner) ()
		- parentToken.balanceOfAt(_owner,min(_blockNumber,parentSnapShotBlock)) ()
	Event emitted after the call(s):
	- Transfer(_owner,0,_amount) ()
Reentrancy in MiniMeToken.doTransfer(address,address,uint256) ():
	External calls:
	- previousBalanceFrom = balanceOfAt(_from,block.number) ()
		- parentToken.balanceOfAt(_owner,min(_blockNumber,parentSnapShotBlock)) ()
	- ! Controller(controller).onTransfer(_from,_to,_amount) ()
	- previousBalanceTo = balanceOfAt(_to,block.number) ()
		- parentToken.balanceOfAt(_owner,min(_blockNumber,parentSnapShotBlock)) ()
	Event emitted after the call(s):
	- Transfer(_from,_to,_amount) ()
Reentrancy in MiniMeToken.generateTokens(address,uint256) ():
	External calls:
	- previousBalanceTo = balanceOf(_owner) ()
		- parentToken.balanceOfAt(_owner,min(_blockNumber,parentSnapShotBlock)) ()
	Event emitted after the call(s):
	- Transfer(0,_owner,_amount) ()
Reentrancy in MiniMeIrrevocableVestedToken.grantVestedTokens(address,uint256,uint64,uint64,uint64) ():
	External calls:
	- ! transfer(_to,_value) ()
		- parentToken.balanceOfAt(_owner,min(_blockNumber,parentSnapShotBlock)) ()
		- ! Controller(controller).onTransfer(_from,_to,_amount) ()
	Event emitted after the call(s):
	- NewTokenGrant(msg.sender,_to,_value,_cliff,_vesting,_start) ()
Reentrancy in MiniMeIrrevocableVestedToken.transfer(address,uint256) ():
	External calls:
	- super.transfer(_to,_value) ()
		- parentToken.balanceOfAt(_owner,min(_blockNumber,parentSnapShotBlock)) ()
		- ! Controller(controller).onTransfer(_from,_to,_amount) ()
	- canTransfer(msg.sender,_value) ()
		- parentToken.balanceOfAt(_owner,min(_blockNumber,parentSnapShotBlock)) ()
	Event emitted after the call(s):
	- Transfer(_from,_to,_amount) ()
		- super.transfer(_to,_value) ()
Reentrancy in MiniMeIrrevocableVestedToken.transferFrom(address,address,uint256) ():
	External calls:
	- super.transferFrom(_from,_to,_value) ()
